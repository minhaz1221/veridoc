# Sepolia RPC endpoint (e.g. Alchemy or Infura)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Deployer private key (no 0x prefix needed by hardhat config, but add it anyway)
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Etherscan API key for source verification
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY

# --- Frontend (public) ---
NEXT_PUBLIC_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
NEXT_PUBLIC_CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS
NEXT_PUBLIC_CHAIN_ID=11155111

# Optional: base URL for QR codes generated by the CLI
WEB_URL=https://veridoc.vercel.app
